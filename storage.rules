rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Completion-report PDFs: candidate's browser uploads its own report
    // once it passes all 5 days (no login exists, matching every other
    // collection in this app), admin reads the link from the dashboard,
    // and the emailed link itself is publicly readable too.
    match /completion-reports/{fileName} {
      allow read: if true;
      allow write: if true;
    }
  }
}
